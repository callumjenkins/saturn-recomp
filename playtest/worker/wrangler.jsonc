{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "saturn-playtest",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "d1_databases": [
    { "binding": "DB", "database_name": "saturn-playtest", "database_id": "c34e3fe6-2333-4aa8-ab34-0e12af9ab3c6", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "saturn-playtest" }
  ],
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "rooms", "new_sqlite_classes": ["Room"] }],
  // ADMIN_TOKEN is the maintainer's CLI, CI_TOKEN the release workflow's. TURN_KEY_ID and TURN_KEY_API_TOKEN are a
  // Cloudflare TURN key, which rooms make each peer's credentials from; without them, rooms give STUN alone.
  "secrets": { "required": ["ADMIN_TOKEN", "CI_TOKEN", "TURN_KEY_ID", "TURN_KEY_API_TOKEN"] }
}
